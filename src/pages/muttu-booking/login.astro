---
export const prerender = false;
import LoginForm from '@/components/booking/LoginForm';

const redirect = Astro.url.searchParams.get('redirect') ?? '/muttu-booking/events';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In | Nagayakshi Temple Muttu Booking</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <LoginForm redirect={redirect} client:load />
</body>
</html>
