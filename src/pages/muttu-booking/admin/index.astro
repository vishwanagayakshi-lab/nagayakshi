---
export const prerender = false;
import { createClient, createAdminClient } from '@/lib/supabase/server';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { paise } from '@/lib/utils';

const supabase = createClient(Astro);
const { data: { user } } = await supabase.auth.getUser();
if (!user) return Astro.redirect('/admin/login?redirect=/muttu-booking/admin');

const admin = createAdminClient();

const { data: profile } = await admin.from('profiles').select('is_admin').eq('id', user.id).single();
if (!profile?.is_admin) return Astro.redirect('/');

const [
  { count: totalEvents },
  { count: openEvents },
  { count: totalBookings },
  { count: confirmedBookings },
  { count: pendingPhone },
  { count: totalOfferings },
  { count: paidOfferings },
] = await Promise.all([
  admin.from('muttu_events').select('*', { count: 'exact', head: true }),
  admin.from('muttu_events').select('*', { count: 'exact', head: true }).eq('status', 'open'),
  admin.from('bookings').select('*', { count: 'exact', head: true }),
  admin.from('bookings').select('*', { count: 'exact', head: true }).eq('status', 'confirmed'),
  admin.from('bookings').select('*', { count: 'exact', head: true }).eq('booking_type', 'phone').in('status', ['pending', 'payment_init']),
  admin.from('offerings').select('*', { count: 'exact', head: true }),
  admin.from('offerings').select('*', { count: 'exact', head: true }).eq('status', 'paid'),
]);

const { data: recentBookings } = await admin
  .from('bookings')
  .select('*, event:muttu_events(name)')
  .order('created_at', { ascending: false })
  .limit(5);

const { data: recentOfferings } = await admin
  .from('offerings')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);

function fmt(iso: string) {
  return new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}

const topStats = [
  { label: 'Open Events',        value: openEvents ?? 0,        href: '/muttu-booking/admin/events' },
  { label: 'Total Bookings',     value: totalBookings ?? 0,     href: '/muttu-booking/admin/bookings' },
  { label: 'Confirmed Bookings', value: confirmedBookings ?? 0, href: '/muttu-booking/admin/bookings' },
  { label: 'Offerings & Donations', value: totalOfferings ?? 0, href: '/muttu-booking/admin/offerings' },
];
---

<AdminLayout title="Dashboard">

  <!-- Top stat cards -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:28px">
    {topStats.map(s => (
      <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;padding:24px;box-shadow:0 2px 8px rgba(37,99,235,0.06);position:relative;overflow:hidden">
        <div style="position:absolute;top:-20px;right:-20px;width:80px;height:80px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,0.08) 0%,transparent 70%);pointer-events:none"></div>
        <p style="font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#64748b;margin-bottom:10px">{s.label}</p>
        <p style="font-size:40px;font-weight:700;letter-spacing:-0.04em;line-height:1;color:#0f172a;margin-bottom:14px">{s.value}</p>
        <a href={s.href} style="font-size:12px;color:#2563eb;text-decoration:none;font-weight:500;display:inline-flex;align-items:center;gap:4px;opacity:0.85;transition:opacity 0.15s"
           onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.85'">
          View all <span style="font-size:14px">→</span>
        </a>
      </div>
    ))}

    <!-- Notifications card -->
    <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;padding:24px;box-shadow:0 2px 8px rgba(37,99,235,0.06)">
      <p style="font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#64748b;margin-bottom:10px">Notifications</p>
      {(pendingPhone ?? 0) > 0 ? (
        <>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
            <span style="width:7px;height:7px;border-radius:50%;background:#f59e0b;flex-shrink:0"></span>
            <span style="font-size:13px;font-weight:500;color:#b45309">{pendingPhone} phone booking{pendingPhone === 1 ? '' : 's'} awaiting</span>
          </div>
          <p style="font-size:12px;color:#64748b;line-height:1.6">Confirm or cancel them from the Bookings page.</p>
        </>
      ) : (
        <>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
            <span style="width:7px;height:7px;border-radius:50%;background:#34d399;flex-shrink:0"></span>
            <span style="font-size:13px;font-weight:500;color:#059669">All caught up</span>
          </div>
          <p style="font-size:12px;color:#64748b;line-height:1.6">No phone bookings awaiting confirmation.</p>
        </>
      )}
    </div>
  </div>

  <p style="font-size:12px;color:#94a3b8;margin:-16px 0 20px">{totalEvents ?? 0} total events · {paidOfferings ?? 0} offerings paid</p>

  <!-- Recent activity grid -->
  <div class="recent-grid" style="display:grid;gap:16px">

    <!-- Recent Bookings -->
    <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(37,99,235,0.06)">
      <div style="padding:16px 20px;border-bottom:1px solid rgba(37,99,235,0.12);display:flex;align-items:center;justify-content:space-between">
        <h2 style="font-size:13px;font-weight:600;color:#0f172a;letter-spacing:-0.01em">Recent Bookings</h2>
        <a href="/muttu-booking/admin/bookings" style="font-size:11px;color:#2563eb;text-decoration:none;font-weight:500;opacity:0.8" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'">View all</a>
      </div>
      {recentBookings && recentBookings.length > 0 ? (
        <ul style="list-style:none;margin:0;padding:0">
          {recentBookings.map((b: any, i: number) => (
            <li style={`padding:12px 20px;${i < recentBookings.length - 1 ? 'border-bottom:1px solid #f1f5f9' : ''}`}>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:3px">
                <span style="font-size:13px;font-weight:500;color:#0f172a">{b.phone}</span>
                <span style="font-size:11px;color:#94a3b8;flex-shrink:0;font-variant-numeric:tabular-nums">{fmt(b.created_at)}</span>
              </div>
              <span style="font-size:11px;color:#64748b">{(b.event as any)?.name}</span>
              <p style="font-size:11px;color:rgba(37,99,235,0.7);margin-top:2px">{b.booking_ref} · {b.quantity} muttu · {b.status}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p style="padding:48px 20px;text-align:center;font-size:13px;color:#94a3b8">No bookings yet.</p>
      )}
    </div>

    <!-- Recent Offerings -->
    <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(37,99,235,0.06)">
      <div style="padding:16px 20px;border-bottom:1px solid rgba(37,99,235,0.12);display:flex;align-items:center;justify-content:space-between">
        <h2 style="font-size:13px;font-weight:600;color:#0f172a;letter-spacing:-0.01em">Recent Offerings & Donations</h2>
        <a href="/muttu-booking/admin/offerings" style="font-size:11px;color:#2563eb;text-decoration:none;font-weight:500;opacity:0.8" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'">View all</a>
      </div>
      {recentOfferings && recentOfferings.length > 0 ? (
        <ul style="list-style:none;margin:0;padding:0">
          {recentOfferings.map((o: any, i: number) => (
            <li style={`padding:12px 20px;${i < recentOfferings.length - 1 ? 'border-bottom:1px solid #f1f5f9' : ''}`}>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:3px">
                <span style="font-size:13px;font-weight:500;color:#0f172a">{o.devotee_name}</span>
                <span style="font-size:11px;color:#94a3b8;flex-shrink:0;font-variant-numeric:tabular-nums">{fmt(o.created_at)}</span>
              </div>
              <span style="font-size:11px;color:#64748b">{o.purpose}</span>
              <p style={`font-size:11px;margin-top:2px;font-weight:500;color:${o.status === 'paid' ? '#059669' : '#94a3b8'}`}>
                {paise(o.amount)} · {o.status}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p style="padding:48px 20px;text-align:center;font-size:13px;color:#94a3b8">No offerings yet.</p>
      )}
    </div>

  </div>

</AdminLayout>

<style>
  .recent-grid { grid-template-columns: 1fr 1fr; }
  @media (max-width: 720px) {
    .recent-grid { grid-template-columns: 1fr; }
  }
</style>
