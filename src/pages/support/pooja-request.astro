---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pooja Request | Nagayakshi Temple">

  <!-- Hero -->
  <section class="request-hero">
    <div class="request-hero-overlay"></div>
    <div class="request-hero-content">
      <span class="hero-label">Divine Offerings</span>
      <h1>Request a Pooja</h1>
      <p>Submit your pooja request and the temple will get back to you with all the details</p>
    </div>
  </section>

  <!-- Info Strip -->
  <section class="info-strip">
    <div class="strip-container">
      <div class="strip-item">
        <span class="strip-icon">📿</span>
        <span>Fill the form below with your details</span>
      </div>
      <div class="strip-divider"></div>
      <div class="strip-item">
        <span class="strip-icon">🙏</span>
        <span>The temple will get back to you with all details</span>
      </div>
    </div>
  </section>

  <!-- Form Section -->
  <section class="form-section">
    <div class="form-container">

      <div class="form-intro">
        <h2>Fill Your Details</h2>
        <p>
          Every request is received with devotion and attended to with care by the temple.
        </p>
      </div>

      <div class="form-wrapper">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSeHyjiAF_zq17jLDcIuZtvjOmZSG1rFUNfaLFfisVpUJ23pug/viewform?embedded=true"
          class="google-form"
          title="Pooja Request Form"
          loading="lazy"
        >
          Loading form...
        </iframe>
      </div>

    </div>
  </section>

  <!-- Contact Fallback -->
  <section class="contact-fallback">
    <div class="fallback-container">
      <div class="fallback-content">
        <h3>Prefer to Contact Directly?</h3>
        <p>Reach out to us via phone or WhatsApp for immediate assistance with your pooja request.</p>
        <div class="fallback-actions">
          <a href="tel:+919946373522" class="btn-call">
            <span>📞</span> Call: +91 9946373522
          </a>
          <a href="https://wa.me/919946373522" class="btn-whatsapp" target="_blank" rel="noopener">
            <span>💬</span> WhatsApp Us
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
/* Hero */
.request-hero {
  position: relative;
  min-height: 55vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(rgba(82, 14, 9, 0.88), rgba(82, 14, 9, 0.88)),
    url('/images/temple1.jpg') center/cover;
  padding: 8rem 2rem 4rem;
  text-align: center;
}

.request-hero-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(212, 165, 116, 0.15) 0%, transparent 70%);
}

.request-hero-content {
  max-width: 800px;
  position: relative;
  z-index: 10;
}

.hero-label {
  display: inline-block;
  font-size: 0.9rem;
  color: var(--gold-light);
  text-transform: uppercase;
  letter-spacing: 4px;
  margin-bottom: 1.2rem;
  font-weight: 600;
}

.request-hero h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 4.5rem;
  font-weight: 700;
  color: white;
  margin-bottom: 1rem;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.request-hero p {
  font-size: 1.3rem;
  color: var(--gold-light);
  line-height: 1.7;
  max-width: 650px;
  margin: 0 auto;
}

/* Info Strip */
.info-strip {
  background: var(--laterite-dark);
  padding: 2rem;
}

.strip-container {
  max-width: 1000px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  flex-wrap: wrap;
}

.strip-item {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--gold-light);
  font-size: 1rem;
  font-weight: 500;
}

.strip-icon {
  font-size: 1.4rem;
}

.strip-divider {
  width: 1px;
  height: 30px;
  background: rgba(255, 255, 255, 0.2);
}

/* Form Section */
.form-section {
  padding: 5rem 2rem 6rem;
  background: var(--bg-base);
}

.form-container {
  max-width: 900px;
  margin: 0 auto;
}

.form-intro {
  text-align: center;
  margin-bottom: 3rem;
}

.form-intro h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 3rem;
  font-weight: 700;
  color: var(--laterite-red);
  margin-bottom: 1rem;
}

.form-intro p {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.8;
  max-width: 650px;
  margin: 0 auto;
}

.form-wrapper {
  background: var(--bg-alt);
  border-radius: 20px;
  box-shadow: 0 10px 50px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  border: 1px solid var(--border-light);
}

.google-form {
  display: block;
  width: 100%;
  min-height: 900px;
  border: none;
}

/* Contact Fallback */
.contact-fallback {
  padding: 4rem 2rem;
  background: var(--bg-alt);
  border-top: 3px solid var(--gold-light);
}

.fallback-container {
  max-width: 700px;
  margin: 0 auto;
  text-align: center;
}

.fallback-content h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--laterite-red);
  margin-bottom: 1rem;
}

.fallback-content p {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 2rem;
}

.fallback-actions {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-call,
.btn-whatsapp {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 1rem 2rem;
  border-radius: 2px;
  text-decoration: none;
  font-weight: 700;
  font-size: 1rem;
  transition: all 0.3s ease;
  letter-spacing: 0.5px;
}

.btn-call {
  background: var(--laterite-red);
  color: white;
  border: 2px solid var(--gold-light);
  box-shadow: 0 4px 0 rgba(45, 24, 16, 0.4);
}

.btn-call:hover {
  background: var(--saffron);
  color: var(--text-dark);
  transform: translateY(2px);
  box-shadow: 0 2px 0 rgba(45, 24, 16, 0.4);
}

.btn-whatsapp {
  background: #25D366;
  color: white;
  border: 2px solid #128C7E;
  box-shadow: 0 4px 0 rgba(18, 140, 126, 0.4);
}

.btn-whatsapp:hover {
  background: #128C7E;
  transform: translateY(2px);
  box-shadow: 0 2px 0 rgba(18, 140, 126, 0.4);
}

@media (max-width: 768px) {
  .request-hero h1 {
    font-size: 3rem;
  }

  .strip-divider {
    display: none;
  }

  .strip-container {
    flex-direction: column;
    gap: 1rem;
  }

  .google-form {
    min-height: 1100px;
  }

  .fallback-actions {
    flex-direction: column;
    align-items: center;
  }
}
</style>
