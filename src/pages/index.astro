---
import Layout from '../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tPage } from '../i18n/pageMessages';

const locale = Astro.currentLocale ?? 'en';
const t = tPage('home', locale);
const href = (path: string) => getRelativeLocaleUrl(locale, path);
---

<Layout title="Sree Pulikkal Vishwanagayakshi Temple | Authentic Naga Worship">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-eyebrow">{t.hero.eyebrow}</div>
      <h1 class="hero-title">{t.hero.title}</h1>
      <p class="hero-subtitle">
        {t.hero.subtitle}
      </p>
      <div class="hero-ctas">
        <a href={href('poojas')} class="btn btn-primary">{t.hero.cta}</a>
      </div>
    </div>
  </section>

  <!-- Authority Bar -->
  <section class="authority-bar">
    <div class="authority-container">
      <div class="authority-item">
        <svg class="authority-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
        </svg>
        <div class="authority-text">{t.authority[0].title}<br><span>{t.authority[0].subtitle}</span></div>
      </div>
      <div class="authority-item">
        <svg class="authority-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/>
        </svg>
        <div class="authority-text">{t.authority[1].title}<br><span>{t.authority[1].subtitle}</span></div>
      </div>
      <div class="authority-item">
        <svg class="authority-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 22v-6"/><path d="M12 8v8"/><path d="M7 13s1.5-2 5-2 5 2 5 2"/><path d="M7 18s1.5-2 5-2 5 2 5 2"/><path d="M12 8c-2.5 0-4-2.5-4-5 0-2 1.5-3 4-3s4 1 4 3c0 2.5-1.5 5-4 5z"/>
        </svg>
        <div class="authority-text">{t.authority[2].title}<br><span>{t.authority[2].subtitle}</span></div>
      </div>
      <div class="authority-item">
        <svg class="authority-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 21h18"/><path d="M9 8h10"/><path d="M9 12h10"/><path d="M9 16h10"/><path d="M5 4v16"/><path d="M5 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16"/>
        </svg>
        <div class="authority-text">{t.authority[3].title}<br><span>{t.authority[3].subtitle}</span></div>
      </div>
    </div>
  </section>

  <!-- Festival Announcement -->
  <section class="utsav-card-section">
    <div class="utsav-card">
      <div class="utsav-card-image">
        <img src="/images/navagraha-idols-1.jpg" alt="Navagraha Homam — Rahu Peyarchi special homam">
      </div>
      <div class="utsav-card-text">
        <span class="utsav-card-label">{t.utsav.label}</span>
        <h2>{t.utsav.title}</h2>
        <p>{t.utsav.body}</p>
        <p class="utsav-card-dates">{t.utsav.date}</p>
        <a href={href('poojas/navagraha-homam')} class="btn-utsav">{t.utsav.cta}</a>
      </div>
    </div>
  </section>

  <!-- Sacred Offerings -->
  <section class="offerings-section">
    <div class="section-header">
      <h2>{t.offerings.heading}</h2>
      <p>{t.offerings.subheading}</p>
    </div>
    <div class="offerings-grid">
      <div class="offering-card">
        <a href={href('poojas/ayilyam')} class="card-overlay" aria-label="Ayilyam Pooja"></a>
        <div class="offering-image">
          <img src="/images/Ayiliyam.png" alt="Ayilyam Pooja">
        </div>
        <div class="offering-content">
          <span class="offering-badge">{t.offerings.cards[0].badge}</span>
          <h3>{t.offerings.cards[0].title}</h3>
          <p>{t.offerings.cards[0].desc}</p>
          <div class="offering-footer">
            <a href={href('support/pooja-request?homam=Ayilyam%20Pooja')} class="offering-cta">{t.offerings.cards[0].cta}</a>
          </div>
        </div>
      </div>

      <div class="offering-card">
        <a href={href('poojas/navagraha-homam')} class="card-overlay" aria-label="Navagraha Homam"></a>
        <div class="offering-image">
          <img src="/images/navagraha-idols-1.jpg" alt="Navagraha Homam">
        </div>
        <div class="offering-content">
          <span class="offering-badge">{t.offerings.cards[1].badge}</span>
          <h3>{t.offerings.cards[1].title}</h3>
          <p>{t.offerings.cards[1].desc}</p>
          <div class="offering-footer">
            <a href={href('support/pooja-request?homam=Navagraha%20Homam')} class="offering-cta">{t.offerings.cards[1].cta}</a>
          </div>
        </div>
      </div>

      <div class="offering-card">
        <a href={href('poojas/kala-sarpa-bali')} class="card-overlay" aria-label="Kala Sarpa Bali"></a>
        <div class="offering-image">
          <img src="/images/Kala%20sarppabali%20pooja.jpeg" alt="Kala Sarpa Bali">
        </div>
        <div class="offering-content">
          <span class="offering-badge">{t.offerings.cards[2].badge}</span>
          <h3>{t.offerings.cards[2].title}</h3>
          <p>{t.offerings.cards[2].desc}</p>
          <div class="offering-footer">
            <a href={href('support/pooja-request?homam=Kala%20Sarpa%20Bali')} class="offering-cta">{t.offerings.cards[2].cta}</a>
          </div>
        </div>
      </div>

      <div class="offering-card">
        <a href={href('muttu')} class="card-overlay" aria-label="Muttu"></a>
        <div class="offering-image">
          <img src="/images/Payasa%20Bali.jpg" alt="Muttu Offering">
        </div>
        <div class="offering-content">
          <span class="offering-badge">{t.offerings.cards[3].badge}</span>
          <h3>{t.offerings.cards[3].title}</h3>
          <p>{t.offerings.cards[3].desc}</p>
          <div class="offering-footer">
            <a href={href('muttu')} class="offering-cta">{t.offerings.cards[3].cta}</a>
          </div>
        </div>
      </div>

      <div class="offering-card">
        <a href={href('poojas/pratyangira-homam')} class="card-overlay" aria-label="Maha Pratyangira Homam"></a>
        <div class="offering-image">
          <img src="/images/Mahaprathyangari%20homam1.jpeg" alt="Maha Pratyangira Homam">
        </div>
        <div class="offering-content">
          <span class="offering-badge">{t.offerings.cards[4].badge}</span>
          <h3>{t.offerings.cards[4].title}</h3>
          <p>{t.offerings.cards[4].desc}</p>
          <div class="offering-footer">
            <a href={href('support/pooja-request?homam=Maha%20Pratyangira%20Homam')} class="offering-cta">{t.offerings.cards[4].cta}</a>
          </div>
        </div>
      </div>

      <div class="offering-card">
        <a href={href('poojas/guruthi-pooja')} class="card-overlay" aria-label="Maha Guruthi Pooja"></a>
        <div class="offering-image">
          <img src="/images/Maha%20Guruthi%20Pooja.jpeg" alt="Maha Guruthi Pooja">
        </div>
        <div class="offering-content">
          <span class="offering-badge">{t.offerings.cards[5].badge}</span>
          <h3>{t.offerings.cards[5].title}</h3>
          <p>{t.offerings.cards[5].desc}</p>
          <div class="offering-footer">
            <a href={href('support/pooja-request?homam=Maha%20Guruthi%20Pooja')} class="offering-cta">{t.offerings.cards[5].cta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Naga Dosha -->
  <section class="text-section">
    <div class="text-container">
      <h2>{t.nagaDosha.title}</h2>
      <p>{t.nagaDosha.body}</p>
    </div>
  </section>

  <!-- Kashyapa Maharishi Card -->
  <section class="kashyapa-section">
    <div class="kashyapa-card">
      <div class="kashyapa-card-text">
        <span class="kashyapa-label">{t.kashyapa.label}</span>
        <h2>{t.kashyapa.title}</h2>
        <p>{t.kashyapa.body1}</p>
        <p>{t.kashyapa.body2}</p>
        <a href={href('kashyapa-maharishi')} class="btn-kashyapa">{t.kashyapa.cta}</a>
      </div>
      <div class="kashyapa-card-emblem">
        <div class="emblem-ring">
          <div class="emblem-inner">
            <span class="emblem-symbol">ॐ</span>
            <span class="emblem-text">{t.kashyapa.emblemText}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Guardian Section -->
  <section class="guardian-section">
    <div class="guardian-grid">
      <div class="guardian-image">
        <img src="/images/Ambotti.jpg" alt="Ambotti Thampuran">
      </div>
      <div class="guardian-content">
        <h2>{t.guardian.title}</h2>
        <p>{t.guardian.body}</p>
        <blockquote class="guardian-quote">
          &#8220;{t.guardian.quote}&#8221;
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Temple Protocols -->
  <section class="protocols-section">
    <div class="protocols-container">
      <h2>{t.protocols.title}</h2>
      <p>{t.protocols.body}</p>
      <a href={href('protocols')} class="btn-outline-light">{t.protocols.cta}</a>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(to bottom, rgba(45, 24, 16, 0.6), rgba(122, 25, 18, 0.88)),
      url('/images/temple%20main%20entrance.jpg') center/cover;
    background-color: var(--laterite-dark);
    padding: 8rem 2rem 4rem;
    text-align: center;
    border-bottom: 8px solid var(--saffron);
  }

  .hero-content {
    max-width: 900px;
    position: relative;
    z-index: 10;
  }

  .hero-eyebrow {
    font-family: 'Source Serif 4', serif;
    font-size: 1.05rem;
    color: var(--gold-light);
    text-transform: uppercase;
    letter-spacing: 6px;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .hero-title {
    font-size: 5rem;
    font-weight: 700;
    color: var(--bg-base);
    margin-bottom: 1.5rem;
    line-height: 1.1;
    text-shadow: 0px 4px 20px rgba(0, 0, 0, 0.8);
  }

  .hero-subtitle {
    font-size: 1.35rem;
    color: var(--bg-alt);
    margin-bottom: 3.5rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    font-style: italic;
    opacity: 0.9;
  }

  .hero-ctas {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  /* Authority Bar */
  .authority-bar {
    background: var(--bg-base);
    padding: 3rem 2rem;
    border-bottom: 1px solid var(--border-light);
  }

  .authority-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .authority-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    border: 1px solid var(--border-light);
    background: var(--bg-alt);
    box-shadow: inset 0 0 20px rgba(122, 25, 18, 0.03);
    border-bottom: 4px solid var(--laterite-red);
  }

  .authority-icon {
    width: 45px;
    height: 45px;
    color: var(--saffron);
    margin-bottom: 1.2rem;
  }

  .authority-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--laterite-red);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .authority-text span {
    display: block;
    font-family: 'Source Serif 4', serif;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
    text-transform: none;
    font-style: italic;
  }

  /* Festival Card */
  .utsav-card-section {
    padding: 5rem 2rem;
    background: var(--laterite-dark);
    border-top: 4px solid var(--saffron);
    border-bottom: 4px solid var(--saffron);
  }

  .utsav-card {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .utsav-card-image img {
    width: 100%;
    border-radius: 15px;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.4);
    border: 4px solid var(--gold);
  }

  .utsav-card-label {
    display: inline-block;
    font-family: 'Source Serif 4', serif;
    font-size: 0.85rem;
    color: var(--saffron);
    text-transform: uppercase;
    letter-spacing: 4px;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .utsav-card-text h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--gold-light);
    margin-bottom: 1.2rem;
    line-height: 1.1;
  }

  .utsav-card-text p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .utsav-card-dates {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem !important;
    color: var(--gold) !important;
    font-weight: 700;
  }

  .btn-utsav {
    display: inline-block;
    margin-top: 1rem;
    padding: 1rem 2.5rem;
    background: var(--gold);
    color: var(--text-dark);
    text-decoration: none;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    border: 2px solid var(--gold);
    box-shadow: 0 4px 0 rgba(45, 24, 16, 0.4);
    transition: all 0.3s ease;
  }

  .btn-utsav:hover {
    background: var(--gold-light);
    transform: translateY(2px);
    box-shadow: 0 2px 0 rgba(45, 24, 16, 0.4);
  }

  /* Offerings */
  .offerings-section {
    padding: 6rem 2rem;
  }

  .offerings-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 3rem;
  }

  .offering-card {
    background: var(--bg-base);
    border: 1px solid var(--border-light);
    padding: 0.8rem;
    box-shadow: 0px 10px 30px rgba(122, 25, 18, 0.08);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    position: relative;
  }

  .offering-card:hover {
    transform: translateY(-8px);
    box-shadow: 0px 15px 40px rgba(122, 25, 18, 0.15);
    border-color: var(--saffron);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .offering-image {
    width: 100%;
    height: 280px;
    overflow: hidden;
    border: 1px solid var(--border-light);
  }

  .offering-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.3) saturate(1.1) brightness(0.95);
    transition: transform 0.6s ease;
  }

  .offering-card:hover .offering-image img {
    transform: scale(1.05);
  }

  .offering-content {
    padding: 2rem 1.5rem 1.5rem;
    text-align: center;
    background: var(--bg-alt);
    margin-top: 0.8rem;
  }

  .offering-badge {
    display: inline-block;
    font-family: 'Source Serif 4', serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--saffron);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--saffron);
    padding-bottom: 4px;
  }

  .offering-content h3 {
    font-size: 2.2rem;
    color: var(--laterite-dark);
    margin-bottom: 1rem;
  }

  .offering-content > p {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .offering-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
  }

  .offering-price {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--laterite-red);
  }

  .offering-cta {
    background: transparent;
    color: var(--laterite-red);
    border: 1px solid var(--laterite-red);
    padding: 0.7rem 1.8rem;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
    z-index: 2;
  }

  .offering-cta:hover {
    background: var(--laterite-red);
    color: var(--bg-base);
  }

  /* Naga Dosha */
  .text-section {
    padding: 6rem 2rem;
    background: var(--bg-alt);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    text-align: center;
  }

  .text-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .text-container h2 {
    font-size: 3.2rem;
    margin-bottom: 1.5rem;
    color: var(--laterite-dark);
  }

  .text-container p {
    font-size: 1.2rem;
    color: var(--text-muted);
    line-height: 1.9;
  }

  /* Kashyapa Card */
  .kashyapa-section {
    padding: 5rem 2rem;
    background: var(--laterite-dark);
    border-top: 4px solid var(--saffron);
    border-bottom: 4px solid var(--saffron);
  }

  .kashyapa-card {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .kashyapa-label {
    display: inline-block;
    font-family: 'Source Serif 4', serif;
    font-size: 0.85rem;
    color: var(--saffron);
    text-transform: uppercase;
    letter-spacing: 4px;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .kashyapa-card-text h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--gold-light);
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .kashyapa-card-text p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.9;
    margin-bottom: 1.2rem;
  }

  .btn-kashyapa {
    display: inline-block;
    margin-top: 1rem;
    padding: 1rem 2.5rem;
    background: var(--gold);
    color: var(--text-dark);
    text-decoration: none;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    border: 2px solid var(--gold);
    box-shadow: 0 4px 0 rgba(45, 24, 16, 0.4);
    transition: all 0.3s ease;
  }

  .btn-kashyapa:hover {
    background: var(--gold-light);
    transform: translateY(2px);
    box-shadow: 0 2px 0 rgba(45, 24, 16, 0.4);
  }

  .kashyapa-card-emblem {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .emblem-ring {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 3px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 40px rgba(212, 165, 116, 0.2), inset 0 0 40px rgba(212, 165, 116, 0.05);
  }

  .emblem-inner {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 1px solid rgba(212, 165, 116, 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: rgba(212, 165, 116, 0.06);
  }

  .emblem-symbol {
    font-size: 4rem;
    color: var(--gold);
    line-height: 1;
  }

  .emblem-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--gold-light);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1.4;
  }

  /* Guardian */
  .guardian-section {
    padding: 7rem 2rem;
    background: var(--bg-base);
  }

  .guardian-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .guardian-image img {
    width: 100%;
    border: 1px solid var(--border-light);
    padding: 12px;
    background: var(--bg-alt);
    filter: sepia(0.2) brightness(0.95);
    box-shadow: 0px 15px 40px rgba(122, 25, 18, 0.1);
  }

  .guardian-content h2 {
    font-size: 3.2rem;
    margin-bottom: 1.5rem;
    color: var(--laterite-red);
  }

  .guardian-content > p {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .guardian-quote {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
