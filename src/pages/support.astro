---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Support Kavu Preservation | Nagayakshi Temple">

  <!-- Hero -->
  <section class="support-hero">
    <div class="support-hero-overlay"></div>
    <div class="support-hero-content">
      <h1>Preserve the Sacred Kavus</h1>
      <p>Help protect and restore the seven ancient Sarpa groves for future generations</p>
    </div>
  </section>

  <!-- Unavailable notice -->
  <section class="unavailable-section">
    <div class="support-container">
      <div class="unavailable-card">
        <h2>Online Donations Temporarily Unavailable</h2>
        <p>
          We&#8217;re currently not accepting online donations through this page. If you&#8217;d
          like to support the temple or the Kavu preservation effort, please contact the temple
          office directly.
        </p>
        <a href="tel:+919946373522" class="btn-primary-gold">Call: +91 9946373522</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* Support Page Styles */
.support-hero {
  position: relative;
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(rgba(82, 14, 9, 0.88), rgba(82, 14, 9, 0.88)),
    url('/images/temple1.jpg') center/cover;
  padding: 8rem 2rem 4rem;
  text-align: center;
}

.support-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 50%, rgba(212, 165, 116, 0.15) 0%, transparent 70%);
}

.support-hero-content {
  max-width: 800px;
  position: relative;
  z-index: 10;
}

.support-hero h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 4.5rem;
  font-weight: 700;
  color: white;
  margin-bottom: 1rem;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.support-hero p {
  font-size: 1.4rem;
  color: var(--gold-light);
  line-height: 1.6;
  font-weight: 500;
}

.support-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* Unavailable notice */
.unavailable-section {
  padding: 6rem 2rem;
  background: var(--bg-base);
}

.unavailable-card {
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
  background: var(--bg-alt);
  border: 2px solid var(--border-light);
  border-radius: 14px;
  padding: 3rem 2.5rem;
}

.unavailable-card h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--laterite-red);
  margin-bottom: 1rem;
}

.unavailable-card p {
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.8;
  margin-bottom: 1.8rem;
}

/* Responsive */
@media (max-width: 768px) {
  .support-hero h1 {
    font-size: 3rem;
  }

  .unavailable-card {
    padding: 2.2rem 1.5rem;
  }
}
</style>
