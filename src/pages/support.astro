---
import Layout from '../layouts/Layout.astro';
import OfferingForm from '@/components/booking/OfferingForm';
---

<Layout title="Support Kavu Preservation | Nagayakshi Temple">
  
  <!-- Hero -->
  <section class="support-hero">
    <div class="support-hero-overlay"></div>
    <div class="support-hero-content">
      <h1>Preserve the Sacred Kavus</h1>
      <p>Help protect and restore the seven ancient Sarpa groves for future generations</p>
    </div>
  </section>

  <!-- The Mission -->
  <section class="mission-section">
    <div class="support-container">
      <div class="section-header">
        <span class="section-label">Our Sacred Mission</span>
        <h2>Why Kavu Preservation Matters</h2>
      </div>
      
      <div class="mission-content">
        <div class="mission-text">
          <p class="mission-lead">
            The seven sacred Sarpa Kavus are not merely temple property—they are the living homes
            of the naga deities, the very foundation of this ancient shrine's spiritual power.
            Without these Kavus, the temple loses its essence.
          </p>
          <p>
            For generations, these sacred groves have provided shelter to the Divine Nagas, acting
            as portals where devotees' prayers directly reach the serpent deities. But decades of
            neglect, natural degradation, and the pressures of modern development have threatened
            their integrity.
          </p>
          <p>
            <strong>Our mission is urgent and clear:</strong> Restore all seven Kavus to their
            pristine sacred condition before it's too late. This requires replanting native trees,
            creating protective boundaries, conducting purification rituals, and establishing
            permanent maintenance systems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Donate -->
  <section class="donate-section">
    <div class="support-container donate-container">
      <div class="donate-intro">
        <h2>Make a Donation</h2>
        <p>
          Your contribution goes directly toward Kavu restoration, daily poojas, and temple
          upkeep&#8212;any amount helps.
        </p>
      </div>
      <OfferingForm mode="donation" client:load />
    </div>
  </section>

  <script src="https://checkout.razorpay.com/v1/checkout.js" is:inline></script>

</Layout>

<style>
/* Support Page Styles */
.support-hero {
  position: relative;
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: 
    linear-gradient(rgba(82, 14, 9, 0.88), rgba(82, 14, 9, 0.88)),
    url('/images/temple1.jpg') center/cover;
  padding: 8rem 2rem 4rem;
  text-align: center;
}

.support-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 50%, rgba(212, 165, 116, 0.15) 0%, transparent 70%);
}

.support-hero-content {
  max-width: 800px;
  position: relative;
  z-index: 10;
}

.support-hero h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 4.5rem;
  font-weight: 700;
  color: white;
  margin-bottom: 1rem;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.support-hero p {
  font-size: 1.4rem;
  color: var(--gold-light);
  line-height: 1.6;
  font-weight: 500;
}

.support-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-label {
  display: inline-block;
  font-size: 0.9rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 3px;
  margin-bottom: 1rem;
  font-weight: 600;
}

.section-header h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 3rem;
  font-weight: 700;
  color: var(--laterite-red);
  margin-bottom: 1rem;
}

/* Mission Section */
.mission-section {
  padding: 6rem 2rem;
  background: var(--bg-base);
}

.mission-content {
  max-width: 800px;
  margin: 0 auto;
}

.mission-lead {
  font-size: 1.3rem;
  line-height: 1.9;
  color: var(--laterite-dark);
  font-weight: 500;
  margin-bottom: 1.5rem;
}

.mission-text p {
  font-size: 1.1rem;
  line-height: 1.9;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.mission-text strong {
  color: var(--laterite-red);
}

/* Donate Section */
.donate-section {
  padding: 2rem 2rem 6rem;
  background: var(--bg-base);
}

.donate-container {
  max-width: 600px;
}

.donate-intro {
  text-align: center;
  margin-bottom: 2rem;
}

.donate-intro h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--laterite-red);
  margin-bottom: 1rem;
}

.donate-intro p {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.8;
}

/* Responsive */
@media (max-width: 768px) {
  .support-hero h1 {
    font-size: 3rem;
  }
}
</style>
